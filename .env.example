# Copy to .env and adjust. Never commit real secrets.

# ---- Data layer (Phase 1) ----------------------------------------------------------
# DuckDB file used by the generator (write) and the application (read-only).
DATABASE_URL=duckdb:///database/northwind_cloud.duckdb
# Manifest describing the loaded dataset (used for lineage / dataset_version).
DATASET_MANIFEST_PATH=data/metadata/dataset_manifest.json
# Random seed for synthetic data generation (same seed + config => same dataset).
DATA_SEED=42
# "Today" for the synthetic business.
AS_OF_DATE=2026-08-31
LOG_LEVEL=INFO

# ---- Agent LLM provider (Phase 4) ---------------------------------------------------
# deterministic (alias: offline): rule-based offline model. No key, no network. Used by all tests.
# anthropic: Claude via the official SDK. Needs: pip install -e ".[anthropic]" and ANTHROPIC_API_KEY.
LLM_PROVIDER=deterministic
# Empty = default (claude-opus-5). Only used by the anthropic provider.
LLM_MODEL=
# Empty = provider default (recommended; current Claude Opus models do not accept temperature).
LLM_TEMPERATURE=
LLM_MAX_TOKENS=16000
LLM_TIMEOUT_SECONDS=120
ANTHROPIC_API_KEY=

# ---- Agent limits (Phases 4-5; see app/security/limits.py and docs/security-architecture.md) ----
# The user and the model cannot change these: they are read once when the runner starts.
AGENT_MAX_TOOL_CALLS=12           # MAX_TOOL_CALLS
AGENT_MAX_RETRIES=2               # MAX_RETRIES (per model step, per retryable tool error, per regeneration)
AGENT_MAX_PLANNING_ITERATIONS=2
AGENT_MAX_PLAN_STEPS=8            # MAX_PLAN_STEPS
AGENT_MAX_QUESTION_CHARS=1000     # MAX_QUESTION_LENGTH
AGENT_MAX_FILTERS=5               # MAX_FILTERS
AGENT_MAX_DIMENSIONS=3            # MAX_DIMENSIONS
AGENT_SQL_ROW_LIMIT=200           # MAX_SQL_ROWS (per query)
AGENT_MAX_SQL_ROWS_TOTAL=1000     # SQL rows per run
AGENT_MAX_SQL_CALLS=3             # ad-hoc SQL executions per run
AGENT_MAX_SQL_LENGTH=4000         # MAX_SQL_LENGTH
AGENT_MAX_SQL_JOINS=4
AGENT_MAX_SQL_NESTING_DEPTH=3
AGENT_MAX_CUSTOMER_ROWS=25        # customer-level rows one tool call may return
AGENT_MAX_CONTEXT_ITEMS=40        # MAX_CONTEXT_ITEMS (evidence/claim items per model call)
AGENT_MAX_CONTEXT_CHARS=60000     # prompt size per model call
AGENT_MAX_RESPONSE_CHARS=4000     # MAX_RESPONSE_LENGTH
AGENT_MAX_RUN_SECONDS=120         # wall clock per run
AGENT_TOOL_TIMEOUT_SECONDS=30     # per tool call
AGENT_SQL_TIMEOUT_SECONDS=10      # per ad-hoc SQL statement
# Comma-separated tool names switched off for the agent (e.g. run_safe_sql); unknown names fail at startup.
AGENT_DISABLED_TOOLS=

# ---- MCP server (Phase 6; see docs/mcp-architecture.md) ----
# The MCP server uses the AGENT_* limits above; these settings add only what is MCP-specific.
MCP_SERVER_NAME=agentops-ai
MCP_SERVER_VERSION=0.6.0
# Comma-separated agentops_* tool names to expose; empty exposes all twelve. Unknown names fail at startup.
MCP_ENABLED_TOOLS=
# Only stdio (local development) is supported.
MCP_TRANSPORT=stdio
# DEBUG, INFO (one audit record per tool call), WARNING or ERROR; logs go to stderr.
MCP_LOG_LEVEL=WARNING
# Maximum size of one call's arguments (JSON bytes).
MCP_MAX_REQUEST_BYTES=16384
# Maximum size of one response's structured content (bytes); bulk data is dropped first.
MCP_MAX_RESPONSE_BYTES=262144
# false unlists agentops_run_safe_sql and revokes the SQL privilege for MCP calls.
MCP_SQL_ENABLED=true

# ---- Environment (Phase 9; see docs/deployment.md) --------------------------------------
# development | test | production. production turns on strict API start-up checks: a token, an explicit
# DATABASE_URL, rate limiting on, no wildcard or plain-HTTP CORS origins, and nested timeouts.
APP_ENV=development
# json (one JSON object per line: timestamp, level, logger, event fields) or text.
LOG_FORMAT=json

# ---- HTTP API (Phases 8-9; see docs/api.md and docs/security.md) ----
API_HOST=127.0.0.1
API_PORT=8000
# Authentication: every /api/v1 endpoint except /health and /readiness needs "Authorization: Bearer <token>".
# token (default) or disabled (local development only; refused when APP_ENV=production).
API_AUTH_MODE=token
# At least 32 characters. Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# Never commit a real token. The UI reads the same variable to call the API.
API_AUTH_TOKEN=
# Requests per client on /ask and /ask/stream: N/second, N/minute or N/hour, or off (not in production).
API_RATE_LIMIT=20/minute
API_RATE_LIMIT_MAX_CLIENTS=10000
# Comma-separated browser origins allowed to call the API (scheme://host[:port]). Empty: no cross-origin
# access (the Streamlit UI calls the API from its server, so it needs none). Never * in production.
API_CORS_ORIGINS=
# OpenAPI docs at /docs: empty = on, except in production.
API_DOCS_ENABLED=
API_METRICS_ENABLED=true
# Hard wall-clock limit per /api/v1/ask request (504 after it; the run is cancelled). Keep it above
# AGENT_MAX_RUN_SECONDS and below UI_REQUEST_TIMEOUT_SECONDS.
API_REQUEST_TIMEOUT_SECONDS=150
# Largest accepted request body in bytes (413 above it).
API_MAX_REQUEST_BYTES=16384
# Agent runs are serialised (one read-only DuckDB connection); requests beyond this many waiting get 503.
API_MAX_PENDING_REQUESTS=4
# On SIGTERM/SIGINT, in-flight requests get this long to finish; remaining runs are then cancelled.
API_SHUTDOWN_GRACE_SECONDS=10

# ---- Web UI (Phases 8-9; see docs/ui.md) ----
# Where the Streamlit UI sends questions (the UI never opens the database itself).
UI_API_URL=http://127.0.0.1:8000
# How long the UI waits for an answer; keep it above API_REQUEST_TIMEOUT_SECONDS.
UI_REQUEST_TIMEOUT_SECONDS=180
# python -m app.ui listens here.
UI_HOST=127.0.0.1
UI_PORT=8501
# The hostname users browse to (for example agentops.example.com behind a TLS proxy).
UI_PUBLIC_ADDRESS=localhost
# Questions and answers kept per browser session, in memory only (nothing is persisted).
UI_HISTORY_LIMIT=20
